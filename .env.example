# Template only. Real keys go ONLY in `.env`, which is gitignored. Never put a real key in this file.
# Copy this file to `.env` and fill in the values. The app works without any of them (rule-based fallback).

# Secret key for your AI provider. Read on the server only. Leave empty to use the fallback.
AI_API_KEY=

# Model id to call. Set to a model id from your provider.
AI_MODEL=

# Optional: base URL of an OpenAI-compatible API. Leave empty for the default.
AI_BASE_URL=
